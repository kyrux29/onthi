# OpenAI admin key used only by admin accounts.
OPENAI_API_KEY=sk-your-openai-admin-key
OPENAI_MODEL=gpt-5.4
OPENAI_BASE_URL=https://api.openai.com/v1

# Prefer a dedicated app secret. If omitted, the app can fallback to SUPABASE_JWT_SECRET.
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Supabase Postgres. The app now accepts POSTGRES_URL directly.
POSTGRES_URL=postgres://USER:PASSWORD@HOST:6543/postgres?sslmode=require
POSTGRES_PRISMA_URL=postgres://USER:PASSWORD@HOST:6543/postgres?sslmode=require&pgbouncer=true
POSTGRES_URL_NON_POOLING=postgres://USER:PASSWORD@HOST:5432/postgres?sslmode=require
POSTGRES_DATABASE=postgres
POSTGRES_HOST=db.xxxxxxxxxxxxxxxxxxxx.supabase.co
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-postgres-password
DATABASE_SSL=true

# Optional Supabase variables. This app does not call Supabase Auth/Storage yet,
# but keeping these on Vercel is fine if Supabase generated them for your project.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_SECRET_KEY=your-supabase-secret-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
